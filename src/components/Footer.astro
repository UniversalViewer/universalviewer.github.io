---
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@i18n/utils";
import type { Lang } from "@i18n/ui";
import Logo from "@components/Logo.astro";

const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);

const homeUrl = getRelativeLocaleUrl(locale, "");

const footerNavCol1 = [
  { slug: "how-it-works", key: "nav.how-it-works" },
  { slug: "demo", key: "nav.demo" },
  { slug: "documentation", key: "nav.documentation" },
  { slug: "community", key: "nav.community" },
  { slug: "blog-and-events", key: "nav.blog-and-events" },
] as const;

const footerNavCol2 = [
  { slug: "policies", key: "nav.policies" },
  { slug: "contact-us", key: "nav.contact-us" },
  { slug: "accessibility", key: "nav.accessibility" },
  { slug: "roadmaps-and-strategies", key: "nav.roadmaps-and-strategies" },
  { slug: "contribution-members", key: "nav.contribution-members" },
] as const;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-main">
      <section class="footer-logo-and-contact">
        <Logo type="alt-stacked" name="footer-logo" />

        <h2 class="tiny-heading footer-contact-heading">Contact</h2>
        <a href="mailto:hello@universalviewer.io" class="footer-mailto"
          >hello@universalviewer.io</a
        >
      </section>

      <section class="footer-navigation">
        <nav aria-label="" class="footer-nav footer-nav-1">
          <ul class="footer-nav-list">
            {
              footerNavCol1.map((link, i) => (
                <li class="footer-nav-item">
                  <a
                    href={getRelativeLocaleUrl(locale, link.slug)}
                    class="footer-nav-link"
                  >
                    {t(link.key)}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <nav aria-label="" class="footer-nav footer-nav-2">
          <ul class="footer-nav-list">
            {
              footerNavCol2.map((link, i) => (
                <li class="footer-nav-item">
                  <a
                    href={getRelativeLocaleUrl(locale, link.slug)}
                    class="footer-nav-link"
                  >
                    {t(link.key)}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </section>

      <section class="footer-social">
        <h2 class="tiny-heading footer-social-heading">
          {t("footer.connect")}
        </h2>
        <ul class="footer-social-list">
          <li class="footer-social-item">
            <a
              href="https://github.com/universalviewer"
              target="_blank"
              rel="noopener"
              aria-label="GitHub"
              class="footer-social-link"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="currentColor"
                class="bi bi-github"
                viewBox="0 0 16 16"
              >
                <path
                  d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"
                ></path>
              </svg>
            </a>
          </li>
          <li class="footer-social-item">
            <a
              href="https://bsky.app/profile/universalviewer.io"
              target="_blank"
              rel="noopener"
              aria-label="Bluesky"
              class="footer-social-link"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="currentColor"
                class="bi bi-bluesky"
                viewBox="0 0 16 16"
              >
                <path
                  d="M3.468 1.948C5.303 3.325 7.276 6.118 8 7.616c.725-1.498 2.698-4.29 4.532-5.668C13.855.955 16 .186 16 2.632c0 .489-.28 4.105-.444 4.692-.572 2.04-2.653 2.561-4.504 2.246 3.236.551 4.06 2.375 2.281 4.2-3.376 3.464-4.852-.87-5.23-1.98-.07-.204-.103-.3-.103-.218 0-.081-.033.014-.102.218-.379 1.11-1.855 5.444-5.231 1.98-1.778-1.825-.955-3.65 2.28-4.2-1.85.315-3.932-.205-4.503-2.246C.28 6.737 0 3.12 0 2.632 0 .186 2.145.955 3.468 1.948"
                ></path>
              </svg>
            </a>
          </li>
          <li class="footer-social-item">
            <a
              href="https://glammr.us/@universalviewer"
              target="_blank"
              rel="noopener"
              aria-label="Mastodon"
              class="footer-social-link"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="currentColor"
                class="bi bi-mastodon"
                viewBox="0 0 16 16"
              >
                <path
                  d="M11.19 12.195c2.016-.24 3.77-1.475 3.99-2.603.348-1.778.32-4.339.32-4.339 0-3.47-2.286-4.488-2.286-4.488C12.062.238 10.083.017 8.027 0h-.05C5.92.017 3.942.238 2.79.765c0 0-2.285 1.017-2.285 4.488l-.002.662c-.004.64-.007 1.35.011 2.091.083 3.394.626 6.74 3.78 7.57 1.454.383 2.703.463 3.709.408 1.823-.1 2.847-.647 2.847-.647l-.06-1.317s-1.303.41-2.767.36c-1.45-.05-2.98-.156-3.215-1.928a4 4 0 0 1-.033-.496s1.424.346 3.228.428c1.103.05 2.137-.064 3.188-.189zm1.613-2.47H11.13v-4.08c0-.859-.364-1.295-1.091-1.295-.804 0-1.207.517-1.207 1.541v2.233H7.168V5.89c0-1.024-.403-1.541-1.207-1.541-.727 0-1.091.436-1.091 1.296v4.079H3.197V5.522q0-1.288.66-2.046c.456-.505 1.052-.764 1.793-.764.856 0 1.504.328 1.933.983L8 4.39l.417-.695c.429-.655 1.077-.983 1.934-.983.74 0 1.336.259 1.791.764q.662.757.661 2.046z"
                ></path>
              </svg>
            </a>
          </li>
          <li class="footer-social-item">
            <a
              href="https://universalviewer.slack.com"
              target="_blank"
              rel="noopener"
              aria-label="Slack"
              class="footer-social-link"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="currentColor"
                class="bi bi-slack"
                viewBox="0 0 16 16"
              >
                <path
                  d="M3.362 10.11c0 .926-.756 1.681-1.681 1.681S0 11.036 0 10.111.756 8.43 1.68 8.43h1.682zm.846 0c0-.924.756-1.68 1.681-1.68s1.681.756 1.681 1.68v4.21c0 .924-.756 1.68-1.68 1.68a1.685 1.685 0 0 1-1.682-1.68zM5.89 3.362c-.926 0-1.682-.756-1.682-1.681S4.964 0 5.89 0s1.68.756 1.68 1.68v1.682zm0 .846c.924 0 1.68.756 1.68 1.681S6.814 7.57 5.89 7.57H1.68C.757 7.57 0 6.814 0 5.89c0-.926.756-1.682 1.68-1.682zm6.749 1.682c0-.926.755-1.682 1.68-1.682S16 4.964 16 5.889s-.756 1.681-1.68 1.681h-1.681zm-.848 0c0 .924-.755 1.68-1.68 1.68A1.685 1.685 0 0 1 8.43 5.89V1.68C8.43.757 9.186 0 10.11 0c.926 0 1.681.756 1.681 1.68zm-1.681 6.748c.926 0 1.682.756 1.682 1.681S11.036 16 10.11 16s-1.681-.756-1.681-1.68v-1.682h1.68zm0-.847c-.924 0-1.68-.755-1.68-1.68s.756-1.681 1.68-1.681h4.21c.924 0 1.68.756 1.68 1.68 0 .926-.756 1.681-1.68 1.681z"
                ></path>
              </svg>
            </a>
          </li>
        </ul>
      </section>
    </div>

    <p class="footer-copyright">
      <span aria-label={t("footer.copyright")}>&copy;</span> Universal Viewer {
        new Date().getFullYear()
      }
    </p>
  </div>
</footer>
