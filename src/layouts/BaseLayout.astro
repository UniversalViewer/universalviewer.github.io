---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.scss";

interface Props {
  pageTitle?: string;
  mainClass?: string;
}

const { pageTitle = "Universal Viewer", mainClass } = Astro.props;
