---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.scss";

interface Props {
  pageTitle?: string;
  mainClass?: string;
}

const { pageTitle = "Universal Viewer", mainClass } = Astro.props;
---

<html lang="en" class="dm-sans-regular">
  <head>
    <meta charset="utf-8" />
    <!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Onest:wght@100..900&family=Pavanam&family=Spectral:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;0,800;1,200;1,300;1,400;1,500;1,600;1,700;1,800&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <svg
      width="218"
      height="217"
      viewBox="0 0 218 217"
      xmlns="http://www.w3.org/2000/svg"
      style="display: none;"
    >
      <defs>
        <symbol id="corner" viewBox="0 0 218 217">
          <path
            d="M217.24 32.4239V0L109.421 0C97.9259 9.59509e-05 86.8975 4.5501 78.7455 12.6556L12.8295 78.1959C4.61774 86.3614 0 97.4649 0 109.047L0 216.583H33.0822V158.606C33.0824 88.9177 89.5757 32.4239 159.264 32.4239H217.24Z"
          ></path>
        </symbol>
      </defs>
    </svg>
    <Header />
    <main class:list={["main", mainClass]}>
      <slot />
    </main>
    <Footer />
    <!-- <script>
      import "../scripts/menu.js";
    </script> -->
  </body>
</html>
