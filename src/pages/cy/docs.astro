---
import { Icon } from "astro-icon/components";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@i18n/utils";
import type { Lang } from "@i18n/ui";
import BaseLayout from "@layouts/BaseLayout.astro";
const pageTitle = "Dogfennaeth";

const locale = Astro.currentLocale as Lang;

const t = useTranslations(locale);

const communityUrl = getRelativeLocaleUrl(locale, "community");
---

<BaseLayout pageTitle={pageTitle} mainClass="docs-main">
  <div class="container">
    <header class="page-heading">
      <h1>Dogfennaeth</h1>
      <p>
        Archwiliwch ein hadnoddau a’n canllawiau i’ch helpu i osod Universal
        Viewer a gwneud y gorau o’i nodweddion.
      </p>
    </header>
  </div>

  <section class="doc-boxes-section">
    <div class="container">
      <div class="doc-boxes">
        <div class="corner-box doc-box">
          <div class="corner-box-content doc-box-content">
            <div class="doc-box-icon">
              <Icon name="mouse" />
            </div>
            <div class="doc-box-text">
              <h2>Darllenwch y llawlyfr</h2>
              <p>
                Darllenwch y llawlyfr i gael gwybodaeth am ddefnyddio,
                ffurfweddu a datblygu ar gyfer yr UV.
              </p>
              <a
                href="https://github.com/UniversalViewer/universalviewer/blob/dev/manual/index.md"
                target="_blank"
                class="mt-28 button">Llawlyfr</a
              >
            </div>
          </div>
          <div class="corner-box-corner corner-box-tl">
            <svg>
              <use href="#cornerTopLeft"></use>
            </svg>
          </div>
          <div class="corner-box-corner corner-box-tr">
            <svg>
              <use href="#cornerTopRight"></use>
            </svg>
          </div>
          <div class="corner-box-corner corner-box-bl">
            <svg>
              <use href="#cornerBottomLeft"></use>
            </svg>
          </div>
          <div class="corner-box-corner corner-box-br">
            <svg>
              <use href="#cornerBottomRight"></use>
            </svg>
          </div>
        </div>
        <div class="corner-box doc-box">
          <div class="corner-box-content doc-box-content">
            <div class="doc-box-icon">
              <Icon name="settings" />
            </div>
            <div class="doc-box-text">
              <h2>Dogfennau technegol</h2>
              <p>
                Yn barod i ddechrau? Dewch o hyd i’r canllawiau technegol sydd
                eu hangen ar eich tîm datblygu i osod a ffurfweddu Universal
                Viewer.
              </p>
              <a
                target="_blank"
                href="https://docs.universalviewer.io/"
                class="mt-28 button">Dogfennau</a
              >
            </div>
          </div>
          <div class="corner-box-corner corner-box-tl">
            <svg>
              <use href="#cornerTopLeft"></use>
            </svg>
          </div>
          <div class="corner-box-corner corner-box-tr">
            <svg>
              <use href="#cornerTopRight"></use>
            </svg>
          </div>
          <div class="corner-box-corner corner-box-bl">
            <svg>
              <use href="#cornerBottomLeft"></use>
            </svg>
          </div>
          <div class="corner-box-corner corner-box-br">
            <svg>
              <use href="#cornerBottomRight"></use>
            </svg>
          </div>
        </div>
        <div class="corner-box doc-box">
          <div class="corner-box-content doc-box-content">
            <div class="doc-box-icon">
              <Icon name="video" />
            </div>
            <div class="doc-box-text">
              <h2>Enghreifftiau Gweithredu</h2>
              <p>
                Gweler yr enghreifftiau i weld sut mae defnyddio'r UV mewn
                gwahanol sefyllfaoedd.
              </p>
              <a
                href="https://github.com/UniversalViewer/universalviewer/wiki/UV-Examples"
                target="_blank"
                class="mt-28 button"
              >
                Enghreifftiau</a
              >
            </div>
          </div>
          <div class="corner-box-corner corner-box-tl">
            <svg>
              <use href="#cornerTopLeft"></use>
            </svg>
          </div>
          <div class="corner-box-corner corner-box-tr">
            <svg>
              <use href="#cornerTopRight"></use>
            </svg>
          </div>
          <div class="corner-box-corner corner-box-bl">
            <svg>
              <use href="#cornerBottomLeft"></use>
            </svg>
          </div>
          <div class="corner-box-corner corner-box-br">
            <svg>
              <use href="#cornerBottomRight"></use>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mt-72 community-section">
    <div class="container">
      <div class="community-box">
        <div class="community-box-heading">
          <h2 class="mt-0">
            <span class="eyebrow"> Cymorth pan fydd ei angen arnoch </span>
            Cymorth ar gael drwy'r broses osod a thu hwnt.
          </h2>
          <a href={communityUrl} class="button community-box-heading-button"
            >{t("general.learnMore")}</a
          >
        </div>

        <div class="community-box-content">
          <div class="community-box-item">
            <div class="community-box-item-icon">
              <Icon name="slack" />
            </div>
            <p class="community-box-item-text">
              {t("general.slack")}
            </p>
          </div>

          <div class="community-box-item">
            <div class="community-box-item-icon">
              <Icon name="video" />
            </div>
            <p class="community-box-item-text">
              {t("general.calls")}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
