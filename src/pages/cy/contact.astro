---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@i18n/utils";
import type { Lang } from "@i18n/ui";

const locale = Astro.currentLocale as Lang;

const t = useTranslations(locale);

const pageTitle = t("nav.contact-us");
---

<BaseLayout pageTitle={pageTitle} mainClass="contact-main">
  <div class="container">
    <header class="page-heading">
      <h1>{pageTitle}</h1>
    </header>
  </div>
  <div class="container">
    <section id="getting-started">
      <h2>Sut alla i gysylltu â’r Grŵp Llywio?</h2>
      <p>
        Gallwch ymuno â’r Grŵp Llywio drwy ddod yn noddwr i’r prosiect ar <a
          href="https://opencollective.com/universalviewer">Open Collective</a
        >. I drafod manteision aelodaeth, anfonwch e-bost at <a
          href="mailto:universalviewerapp@gmail.com"
          >universalviewerapp@gmail.com</a
        >.
      </p>
      <h2 class="mt-36">Sut alla i gysylltu ag aelodau’r gymuned?</h2>
      <h3>Gofyn cwestiwn ar Slack</h3>
      <p>
        Y ffordd gyflymaf o gael cymorth yw drwy ein gweithle cymunedol ar <a
          href="https://universalviewer.slack.com/">Slack</a
        >. Anfonwch e-bost at <a href="mailto:universalviewerapp@gmail.com"
          >universalviewerapp@gmail.com</a
        > i ofyn am wahoddiad i ymuno.
      </p>
      <h3>Rhoi gwybod am wall neu awgrymu nodwedd neu welliant</h3>
      <p>
        Os ydych wedi dod ar draws gwall neu os oes gennych syniad am nodwedd
        newydd gyffrous, edrychwch ar <a
          href="https://github.com/UniversalViewer/universalviewer/issues"
          >y materion sydd eisoes wedi’u cofnodi ar GitHub Universal Viewer</a
        > cyn ychwanegu un newydd. Dim cyfrif GitHub gennych? Dewch i’n cyfarfod cymunedol
        neu cysylltwch â ni ar <a href="https://universalviewer.slack.com/"
          >Slack</a
        > i drafod eich syniadau gyda’r gymuned.
      </p>

      <h2 class="mt-36">
        Ble alla i ddod o hyd i Universal Viewer ar y cyfryngau cymdeithasol?
      </h2>
      <div class="logos-grid">
        <a
          href="https://universalviewer.slack.com"
          class="logo-item"
          aria-label="Slack"
        >
          <img src="/img/logos/slack.webp" alt="Slack" />
        </a>
        <a
          href="https://bsky.app/profile/universalviewer.io"
          class="logo-item"
          aria-label="Bluesky"
        >
          <img src="/img/logos/Bluesky_Logo.svg" alt="Bluesky" />
        </a>
        <a
          href="https://glammr.us/@universalviewer"
          class="logo-item"
          aria-label="Mastodon"
        >
          <img src="/img/logos/Mastodon.svg" alt="Mastodon" />
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
